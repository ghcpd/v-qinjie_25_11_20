{
  "name": "nextjs-security-eval",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev secure -p 3000",
    "dev:insecure": "next dev insecure -p 3000",
    "build": "next build secure",
    "build:insecure": "next build insecure",
    "start": "next start secure -p 3000",
    "test": "node tests/runSecurityScan.js && jest --runInBand",
    "lint": "next lint",
    "security:scan": "node tests/runSecurityScan.js"
  },
  "dependencies": {
    "autoprefixer": "^10.4.16",
    "clsx": "^1.2.1",
    "isomorphic-dompurify": "^2.4.0",
    "next": "^14.2.3",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.4"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.12.7",
    "@types/react": "18.2.74",
    "@types/react-dom": "18.2.24",
    "@types/react": "19.2.6",
    "glob": "^10.3.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(t|j)sx?$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "roots": [
      "<rootDir>/tests"
    ]
  }
}
